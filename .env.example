# Node API - environment variables
# ================================
# Set these in hPanel > Environment variables on each Hostinger account
# (copy to .env.development for local development). No domain is written in the
# code: moving to another domain only means changing the values below.
#
#                     Staging                                                  Client
# SITE_URL            https://financiallyup.innotechcloud.online               https://financiallyup.com.au
# API_URL             https://api-financiallyup.innotechcloud.online           https://api.financiallyup.com.au
# PHP_PDF_SERVER_URL  https://financiallyup-php-server.innotechcloud.online    https://api-php.financiallyup.com.au
# DB_PREFIX           u272433291_                                              u114088816_

PORT=5000
NODE_ENV=development

# ─── Domains ───
# Website + admin portal (email links, website cache refresh, allowed CORS origin)
SITE_URL=http://localhost:3000
# This API, without /api (links to uploaded files and the logo in PDFs)
API_URL=http://localhost:5000
# PHP PDF service
PHP_PDF_SERVER_URL=http://localhost/myProjects/nextjs/financially-up/financially-up-php-backend
# Optional: extra allowed origins, comma separated (SITE_URL is always allowed)
CORS_ORIGINS=

# ─── Database ───
# Hostinger account prefix, added to DB_NAME and DB_USER (leave empty locally)
DB_PREFIX=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=financially-up
DB_USER=root
DB_PASSWORD=

# ─── Secrets (different on every server, never commit real values) ───
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Same value as the website's REVALIDATE_SECRET
REVALIDATE_SECRET=
# Same value as the PHP service's common/secrets.php
PDF_SERVICE_SECRET=
# Encrypts saved mailbox passwords (Settings > Email Sending)
EMAIL_ENCRYPTION_KEY=
# Optional: secret for unguessable PDF file names (JWT_SECRET is used otherwise)
FILE_LINK_SECRET=

# ─── Email (only used until a mailbox is added in Settings > Email Sending) ───
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_SENDER=
EMAIL_RECEIVER=
EMAIL_CC=

# ─── Limits ───
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
